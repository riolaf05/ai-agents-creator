# =======================================================
# AI Agents Creator - configurazione
# =======================================================

# Quale provider usare per gli LLM: "anthropic", "bedrock" oppure "vertex"
LLM_PROVIDER=anthropic

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Vedi https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AWS Bedrock ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opzionale: solo per credenziali temporanee (STS). Se usi chiavi IAM utente,
# lascia assente o commentato — una riga vuota qui può dare 403 "invalid token".
# AWS_SESSION_TOKEN=
# ModelId Bedrock: base (anthropic.claude-sonnet-4-6) o inference profile EU/US
# (es. eu.anthropic.claude-sonnet-4-6). NON usare id tipo claude-* qui.
BEDROCK_MODEL=anthropic.claude-sonnet-4-6

# --- Google Cloud Vertex AI ---
# Richiede autenticazione GCP: gcloud auth application-default login
# oppure GOOGLE_APPLICATION_CREDENTIALS che punta a una service account key.
# IMPORTANTE: ogni versione Claude va abilitata in Model Garden (Enable) o ricevi 404.
# Sonnet 4.5 (GA, tipicamente già disponibile): .../claude-sonnet-4-5
# Sonnet 4.6 (abilitazione separata): .../claude-sonnet-4-6
VERTEX_PROJECT_ID=
# Deve coincidere con endpoint supportati dal modello: regione (es. europe-west1), global,
# oppure multi-regione eu / us — vedi https://cloud.google.com/vertex-ai/generative-ai/docs/partner-models/use-partner-models
VERTEX_REGION=global
# Consigliato claude-sonnet-4-5 su Vertex finché non abiliti esplicitamente 4-6 nel progetto.
VERTEX_MODEL=claude-sonnet-4-5

# --- Parametri agenti ---
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.3
AGENT_MAX_ITERATIONS=8
# 1 = stampa su stderr ogni round LLM/delega (consigliato in CLI)
AGENT_PROGRESS=1

# --- A2A / Webhook ---
A2A_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=change-me-please

# --- Use case paths ---
KB_INPUT_DIR=./data/input
KB_OUTPUT_DIR=./data/knowledge_base
EDITORIAL_OUTPUT_DIR=./data/editorial

# --- Deploy distribuito (opzionale) ---
# Se imposti l'URL di un agente, l'orchestrator lo chiamera' via A2A HTTP
# invece di eseguirlo in-process. Lascia vuoto per modalita' locale (default).
#
# Knowledge Base agents:
# KB_READER_URL=http://localhost:8001
# KB_CLASSIFIER_URL=http://localhost:8002
# KB_WRITER_URL=http://localhost:8003
# KB_INDEXER_URL=http://localhost:8004
#
# Editorial Calendar agents:
# KB_RESEARCHER_URL=http://localhost:8011
# STRATEGIST_URL=http://localhost:8012
# PLANNER_URL=http://localhost:8013
# COPYWRITER_URL=http://localhost:8014

# --- MCP servers (comma separated names definiti in config) ---
# Esempio: abilita il server filesystem installato localmente
# MCP_SERVERS=filesystem
