# =======================================================
# AI Agents Creator - configurazione
# =======================================================

# Quale provider usare per gli LLM: "anthropic" oppure "bedrock"
LLM_PROVIDER=anthropic

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Vedi https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AWS Bedrock ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opzionale: solo per credenziali temporanee (STS). Se usi chiavi IAM utente,
# lascia assente o commentato — una riga vuota qui può dare 403 "invalid token".
# AWS_SESSION_TOKEN=
# ModelId Bedrock: base (anthropic.claude-sonnet-4-6) o inference profile EU/US
# (es. eu.anthropic.claude-sonnet-4-6). NON usare id tipo claude-* qui.
BEDROCK_MODEL=anthropic.claude-sonnet-4-6

# --- Parametri agenti ---
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.3
AGENT_MAX_ITERATIONS=8
# 1 = stampa su stderr ogni round LLM/delega (consigliato in CLI)
AGENT_PROGRESS=1

# --- A2A / Webhook ---
A2A_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=change-me-please

# --- Use case paths ---
KB_INPUT_DIR=./data/input
KB_OUTPUT_DIR=./data/knowledge_base
EDITORIAL_OUTPUT_DIR=./data/editorial

# --- MCP servers (comma separated names definiti in config) ---
# Esempio: abilita il server filesystem installato localmente
# MCP_SERVERS=filesystem
